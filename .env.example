# ============================================================
# Direct Demand Portal — single root .env (backend + frontend)
# Copy to .env and fill in. Empty values are OK: the app boots
# and shows "not configured" states instead of crashing.
# ============================================================

# --- Neon Postgres (app DB — Live Inventory cache) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/direct_demand?sslmode=require

# --- External supply Postgres (read-only, table: properties) ---
PROPERTIES_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Google Sheets sync (Live Inventory source) ---
# Either a path to the service-account key file, or the inline JSON itself.
# The service account email must be granted Viewer access on the sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
SHEET_ID=1-kxlCnXUv7absl4rpWeMoYIxSAHpWykyjpd9v_5df-o

# How often (minutes) the sheet auto-syncs into Neon
SYNC_INTERVAL_MINUTES=15

# OH photos API (all home photos in one call; joined on the sheet's home_id).
# Default is baked in — override only if the service moves.
# PHOTOS_API_URL=https://backend-prod-561394753846.asia-south2.run.app/api/v1/oh/get-homes-photo/

# --- API ---
CORS_ORIGINS=http://localhost:5173

# --- Google Maps (visit planner) ---
# Server key: Geocoding API enabled (inventory addresses → lat/lng)
MAPS_API_KEY=
# Frontend key: Maps JavaScript API + Directions API enabled (the live map & route)
VITE_MAPS_API_KEY=

# --- Frontend (read by Vite) ---
VITE_API_URL=http://localhost:8000
