# ============================================================
# Direct Demand Portal — single root .env (backend + frontend)
# Copy to .env and fill in. Empty values are OK: the app boots
# and shows "not configured" states instead of crashing.
# ============================================================

# --- Neon Postgres (app DB — Live Inventory cache) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/direct_demand?sslmode=require

# --- External supply Postgres (read-only, table: properties) ---
PROPERTIES_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Direct-inventory Postgres (read-only, table: oh_pricing) ---
# Openhouse reference prices by society + area — used to price Supply Pipeline units.
DIRECT_INVENTORY_DB_URL=postgresql://user:pass@host/db?sslmode=require

# --- Google Sheets sync (Live Inventory source) ---
# Either a path to the service-account key file, or the inline JSON itself.
# The service account email must be granted Viewer access on the sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
SHEET_ID=1-kxlCnXUv7absl4rpWeMoYIxSAHpWykyjpd9v_5df-o

# How often (minutes) the sheet auto-syncs into Neon
SYNC_INTERVAL_MINUTES=15

# OH photos API (all home photos in one call; joined on the sheet's home_id).
# Default is baked in — override only if the service moves.
# PHOTOS_API_URL=https://backend-prod-561394753846.asia-south2.run.app/api/v1/oh/get-homes-photo/

# --- API ---
CORS_ORIGINS=http://localhost:5173
# extra allowed origins by regex (e.g. Vercel preview deploys)
CORS_ORIGIN_REGEX=

# --- runtime / ops ---
# "dev" | "prod". In prod the app REFUSES to boot on insecure config
# (default JWT_SECRET, missing GOOGLE_OAUTH_CLIENT_ID, localhost CORS).
APP_ENV=dev
# Managed Redis (Upstash rediss:// or Render KV). Empty → in-memory fallback
# (fine for dev / a single instance). Powers shared cache + rate limit + cron lock.
REDIS_URL=
# emit JSON logs (set true in prod for log aggregation)
LOG_JSON=false
# run the cron in this process (set false on extra web replicas; run a single worker)
RUN_SCHEDULER=true
# JWT signing secret — MUST be a strong random value in prod (>=16 chars)
JWT_SECRET=dev-insecure-change-me
# Google OAuth client id — when set, login is enforced (required in prod)
GOOGLE_OAUTH_CLIENT_ID=

# --- Google Maps (visit planner) ---
# Server key: Geocoding API enabled (inventory addresses → lat/lng)
MAPS_API_KEY=
# Frontend key: Maps JavaScript API + Directions API enabled (the live map & route)
VITE_MAPS_API_KEY=

# --- Openhouse Core visit-booking API (server-to-server; never sent to the browser) ---
# Base URL must end in /api/v1/oh/ ; key is the shared X-CRM-Key secret.
CRM_BOOKING_API_BASE_URL=https://staging-561394753846.asia-south2.run.app/api/v1/oh/
CRM_API_KEY=

# --- Frontend (read by Vite) ---
VITE_API_URL=http://localhost:8000
